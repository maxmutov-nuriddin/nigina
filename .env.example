# ===== Majburiy =====
# @BotFather orqali olinadi
TELEGRAM_BOT_TOKEN=
# https://console.groq.com/keys — so'rovlarni tushunish (NLU), transkripsiya, prezentatsiya
GROQ_API_KEY=
# Fondagi doimiy moliyaviy tahlil uchun (boshqa akkaunt bo'lishi mumkin). Bo'sh — GROQ_API_KEY
GROQ_ANALYSIS_API_KEY=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
# Bot faqat shu chat/foydalanuvchi ID'lariga javob beradi (vergul bilan). Bo'sh — hammaga ochiq
ALLOWED_CHAT_IDS=
# Moliyaviy hisob-kitoblar valyutasi
DEFAULT_CURRENCY=UZS
# Lokal: postgresql://USER@localhost:5432/nigina_dev?schema=public
# Docker Compose'da avtomatik beriladi
DATABASE_URL=postgresql://nigina:nigina@localhost:5432/nigina?schema=public
REDIS_URL=redis://localhost:6379

# ===== Groq modellari (https://console.groq.com/docs/models) =====
# Transkripsiya: whisper-large-v3 (aniqroq, o'zbekcha uchun tavsiya) yoki whisper-large-v3-turbo (tezroq, arzonroq)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Chat/NLU: strict json_schema'ni qo'llaydigan model (openai/gpt-oss-120b yoki openai/gpt-oss-20b)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Prezentatsiya mazmuni uchun alohida model (bo'sh — GROQ_CHAT_MODEL)
GROQ_PRESENTATION_MODEL=
# Strict json_schema rejimi (model qo'llamasa false — json_object rejimi)
GROQ_STRICT_JSON=true
# Bo'sh — tilni avtomatik aniqlash (aralash uz/ru nutq uchun). Majburiy: uz yoki ru
GROQ_TRANSCRIPTION_LANGUAGE=
# gpt-oss uchun: low | medium | high. medium — katta/aralash so'rovlarni aniqroq tushunadi (tavsiya)
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=16384
GROQ_TIMEOUT_MS=120000
GROQ_MAX_RETRIES=3
# Asosiy kalit rate limit'ga tushsa, so'rovni tahlil kaliti bilan qayta urinish
GROQ_FALLBACK_TO_ANALYSIS_KEY=false

# ===== Google Gemini (ixtiyoriy) =====
# Kalit bo'lsa: matnni tushunish, prezentatsiya va tahlil Gemini'da; limit/xatoda avtomatik Groq'ga o'tadi.
# Kalit bo'lmasa: hammasi Groq'da. Ovoz: Groq Whisper asosiy, Gemini zaxira. Kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
# minimal | low | medium | high. Bo'sh — model standarti
GEMINI_REASONING_EFFORT=
GEMINI_TIMEOUT_MS=120000
# Ikkala kalit bo'lsa qaysi biri birinchi: gemini | groq
AI_PRIMARY=gemini

# ===== Ishga tushirish =====
# all | bot | worker (bot — faqat Telegram; worker — eslatmalar + prezentatsiyalar)
APP_ROLE=all
# polling | webhook
BOT_MODE=polling
# Webhook rejimida: to'liq HTTPS URL (…/telegram/webhook) va maxfiy token (1-256 belgi: A-Z a-z 0-9 _ -)
WEBHOOK_URL=
WEBHOOK_SECRET=
# HTTP port: /health, /health/ready (uptime monitor) va webhook
WEBHOOK_PORT=8080
# Polling rejimida ham health server ochilsin
HTTP_ENABLED=true
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Tashkent

# ===== Limitlar =====
MAX_VOICE_SECONDS=600
MAX_VOICE_BYTES=20971520
DAILY_VOICE_LIMIT=100
DAILY_AI_LIMIT=300
DAILY_PRESENTATION_LIMIT=5
MAX_ACTIVE_PRESENTATIONS_PER_USER=1
PRESENTATION_CONCURRENCY=2
MAX_SLIDES=20
DAILY_ANALYSIS_LIMIT=48
FINANCE_ANALYSIS_INTERVAL_MS=600000
FINANCE_SNAPSHOT_MAX_AGE_HOURS=12

# ===== Eslatmalar =====
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH=50
REMINDER_LOCK_SECONDS=120
REMINDER_MAX_ATTEMPTS=5
# Shu daqiqagacha kechikish "o'z vaqtida"
REMINDER_LATE_GRACE_MINUTES=5
# Bundan ko'p kechikkan bir martalik eslatma alohida yuborilmaydi — umumiy "o'tkazib yuborildi" xabari
REMINDER_LATE_MAX_HOURS=12

# ===== Suhbat va maxfiylik =====
CONVERSATION_PENDING_TTL_MINUTES=60
CONVERSATION_HISTORY_TTL_MINUTES=30
TRANSCRIPT_RETENTION_DAYS=30

# ===== Fayllar =====
STORAGE_DIR=./storage
TMP_DIR=./tmp
FFMPEG_PATH=ffmpeg
