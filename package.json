{
  "name": "nigina-bot",
  "version": "1.0.0",
  "description": "Ovoz orqali boshqariladigan AI vazifa yordamchisi (Telegram bot)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "check:groq": "tsx scripts/check-groq.ts",
    "check:gemini": "tsx scripts/check-gemini.ts",
    "check:telegram": "tsx scripts/check-telegram.ts",
    "sample:pptx": "tsx scripts/render-sample.ts",
    "e2e:real": "tsx scripts/e2e-real.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.4.1",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "groq-sdk": "^1.6.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
